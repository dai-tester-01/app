# Comma-separated LiteLLM model identifiers. Provider keys are read by LiteLLM.
# Open-source models on Hugging Face use the huggingface/<org>/<model> prefix.
MODELS=gpt-4o-mini,claude-3-5-haiku-latest,gemini/gemini-2.0-flash

# Optional: a LiteLLM model used to rate all successful responses.
# JUDGE_MODEL=

# Limit each model request and incoming prompt size.
REQUEST_TIMEOUT_SECONDS=30
MAX_PROMPT_CHARACTERS=8000

# Optional: override timeout (seconds) per model as a JSON object.
# Useful for open-source models with Hugging Face cold-start latency.
# MODEL_TIMEOUTS={"huggingface/mistralai/Mistral-7B-Instruct-v0.3": 90}

# Set only the keys required by models selected above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Required for huggingface/ prefixed open-source models.
HUGGINGFACE_API_KEY=
